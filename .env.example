# Site Configuration
NEXT_PUBLIC_SITE_URL=https://kissaymusic.com

# Hygraph (Blog CMS)
# Content API endpoint: Hygraph Project Settings → API Access → Endpoints → High Performance Content API
HYGRAPH_ENDPOINT=https://<region>.cdn.hygraph.com/content/<projectId>/master
# Optional. Only needed if your Content API is NOT publicly readable.
# Create a Permanent Auth Token with "Read Published" permission and paste it here.
# HYGRAPH_TOKEN=

# Add your search engine verification codes here when available
# NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-verification-code
# NEXT_PUBLIC_YANDEX_VERIFICATION=your-yandex-verification-code
